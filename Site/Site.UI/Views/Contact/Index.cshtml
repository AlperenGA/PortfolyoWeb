@model Site.UI.Models.ContactPageViewModel

@{
    ViewData["Title"] = "İletişim";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var info = Model.ContactInfo;
}

<main>
    <div class="page-banner overlay">
        <picture class="media media-bg">
            <source media="(max-width: 575px)" srcset="~/assets/img/banner/page-banner-575.jpg">
            <source media="(max-width: 991px)" srcset="~/assets/img/banner/page-banner-991.jpg">
            <img src="~/assets/img/banner/page-banner.jpg" width="1920" height="520" loading="eager" alt="Page Banner">
        </picture>
        <div class="page-banner-content">
            <div class="container text-center">
                <h1 class="heading text-80 fw-700" data-aos="fade-up">Bize Ulaşın</h1>
                <ul class="breadcrumb list-unstyled" data-aos="fade-up" data-aos-delay="100">
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="text text-18">Anasayfa</a>
                    </li>
                    <li>
                        <svg width="8" height="12" viewBox="0 0 8 12" fill="none"><path d="M7.08929..." fill="currentColor"/></svg>
                    </li>
                    <li><a class="text text-18 active">İletişim</a></li>
                </ul>
            </div>
        </div>
    </div>
    
    <div class="section-contact-form section-padding">
        <div class="container">
            
            @if(TempData["Success"] != null)
            {
                <div class="alert alert-success text-center mb-4" role="alert">
                    @TempData["Success"]
                </div>
            }

            <div class="contact-box radius18">
                <div class="row product-grid justify-content-between">
                    
                    <div class="col-12 col-lg-6 col-contact-content">
                        <div class="section-headings">
                            <div class="subheading text-20 subheading-bg" data-aos="fade-up">
                                <span>İletişim</span>
                            </div>
                  
                            <h2 class="heading text-50" data-aos="fade-up">
                                @(info?.MainHeading ?? "Projeleriniz İçin Bizimle İletişime Geçin")
                            </h2>
                  
                            <p class="text text-18" data-aos="fade-up">
                                @(info?.MainDescription ?? "Size en kısa sürede dönüş yapacağız.")
                            </p>

                            <div class="contact-info-list mt-4">
                                @if(!string.IsNullOrEmpty(info?.Address))
                                {
                                    <div class="d-flex align-items-center mb-3" data-aos="fade-up">
                                        <div class="icon me-3"><i class="bi bi-geo-alt fs-3"></i></div>
                                        <div>
                                            <h5 class="mb-0">Adres</h5>
                                            <p class="mb-0 text-muted">@info.Address</p>
                                        </div>
                                    </div>
                                }
                                @if(!string.IsNullOrEmpty(info?.Phone))
                                {
                                    <div class="d-flex align-items-center mb-3" data-aos="fade-up">
                                        <div class="icon me-3"><i class="bi bi-telephone fs-3"></i></div>
                                        <div>
                                            <h5 class="mb-0">Telefon</h5>
                                            <p class="mb-0 text-muted">@info.Phone</p>
                                        </div>
                                    </div>
                                }
                                @if(!string.IsNullOrEmpty(info?.Email))
                                {
                                    <div class="d-flex align-items-center" data-aos="fade-up">
                                        <div class="icon me-3"><i class="bi bi-envelope fs-3"></i></div>
                                        <div>
                                            <h5 class="mb-0">Email</h5>
                                            <p class="mb-0 text-muted">@info.Email</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
              
                    <div class="col-12 col-lg-6 col-contact-form">
                        <form asp-action="SendMessage" method="post" class="contact-form bg-white p-4 rounded shadow-sm">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Adınız Soyadınız</label>
                                    <input asp-for="ContactMessage.Name" class="form-control" required placeholder="Adınız">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email Adresiniz</label>
                                    <input asp-for="ContactMessage.Email" type="email" class="form-control" required placeholder="Email">
                                </div>
                                <div class="col-12 mb-3">
                                    <label class="form-label">Konu</label>
                                    <input asp-for="ContactMessage.Subject" class="form-control" required placeholder="Mesaj Konusu">
                                </div>
                                <div class="col-12 mb-3">
                                    <label class="form-label">Mesajınız</label>
                                    <textarea asp-for="ContactMessage.Message" class="form-control" rows="5" required placeholder="Mesajınızı buraya yazın..."></textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="button button--primary w-100">Mesajı Gönder</button>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</main>
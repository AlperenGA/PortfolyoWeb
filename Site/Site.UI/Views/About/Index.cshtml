@model Site.UI.Models.AboutPageViewModel

@{
    ViewData["Title"] = "Hakkımızda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
      <div class="page-banner overlay">
        <picture class="media media-bg">
          <source media="(max-width: 575px)" srcset="~/assets/img/banner/page-banner-575.jpg">
          <img src="~/assets/img/banner/page-banner.jpg" width="1920" height="520" loading="eager" alt="Page Banner Image">
        </picture>
        <div class="page-banner-content">
          <div class="container text-center">
            <h1 class="heading text-80 fw-700 aos-init aos-animate" data-aos="fade-up">
              Hakkımızda
            </h1>
            <ul class="breadcrumb list-unstyled aos-init aos-animate" data-aos="fade-up" data-aos-delay="100">
              <li>
                  <a asp-controller="Home" asp-action="Index" class="text text-18" aria-label="Home Page">Anasayfa</a>
              </li>
              <li>
                <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M7.08929 5.40903C7.24552 5.5653 7.33328 5.77723 7.33328 5.9982C7.33328 6.21917 7.24552 6.43109 7.08929 6.58736L2.37512 11.3015C2.29825 11.3811 2.2063 11.4446 2.10463 11.4883C2.00296 11.532 1.89361 11.5549 1.78296 11.5559C1.67231 11.5569 1.56258 11.5358 1.46016 11.4939C1.35775 11.452 1.2647 11.3901 1.18646 11.3119C1.10822 11.2336 1.04634 11.1406 1.00444 11.0382C0.962537 10.9357 0.941453 10.826 0.942414 10.7154C0.943376 10.6047 0.966364 10.4954 1.01004 10.3937C1.05371 10.292 1.1172 10.2001 1.19679 10.1232L5.32179 5.9982L1.19679 1.8732C1.04499 1.71603 0.960996 1.50553 0.962894 1.28703C0.964793 1.06853 1.05243 0.859522 1.20694 0.705015C1.36145 0.550508 1.57046 0.462868 1.78896 0.460969C2.00745 0.45907 2.21795 0.543066 2.37512 0.694864L7.08929 5.40903Z" fill="currentColor"></path></svg>
              </li>
              <li>
                <a class="text text-18 active">Hakkımızda</a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="image-text mt-100">
        <div class="container">
          <div class="row align-items-center">
            
            <div class="col-lg-6 col-12">
              <div class="media-wrap aos-init aos-animate" data-aos="zoom-in-up">
                 @if (!string.IsNullOrEmpty(Model.AboutInfo?.ImageUrl))
                 {
                    <img src="@Model.AboutInfo.ImageUrl" width="992" height="863" loading="lazy" alt="About Image" style="object-fit:cover;">
                 }
                 else
                 {
                    <img src="~/assets/img/image-text/img1.png" width="992" height="863" loading="lazy" alt="Image">
                 }
              </div>
            </div>
            
            <div class="col-lg-6 col-12">
              <div class="content section-headings">
                <div class="subheading text-20 subheading-bg aos-init aos-animate" data-aos="fade-up">
                  <span>Şirketimiz</span>
                </div>
                
                <h2 class="heading text-50 aos-init aos-animate" data-aos="fade-up">
                  @(string.IsNullOrEmpty(Model.AboutInfo?.FullName) ? "Lütfen Admin Panelinden İçerik Ekleyin" : Model.AboutInfo.FullName)
                </h2>
                
                <div class="text text-18 aos-init aos-animate" data-aos="fade-up">
                  @Model.AboutInfo?.ShortDescription
                </div>
                
                <div class="text-lists list-unstyled text text-18 mt-4 aos-init aos-animate" data-aos="fade-up">
                    @Html.Raw(Model.AboutInfo?.LongDescription)
                </div>

                <div class="buttons aos-init aos-animate mt-4" data-aos="fade-up">
                  <a asp-controller="Contact" asp-action="Index" class="button button--primary" aria-label="More About Us">
                    İletişime Geç
                    <span class="svg-wrapper">
                      <svg class="icon-20" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13.3365 7.84518L6.16435 15.0173L4.98584 13.8388L12.158 6.66667H5.83652V5H15.0032V14.1667H13.3365V7.84518Z" fill="CurrentColor"></path></svg>
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="running-content mt-100">
        <div class="container">
          <div class="content-inner">
            <div class="content-lists running-animation">
              
              <div class="content-item">
                @if(Model.Brands != null && Model.Brands.Any())
                {
                    foreach(var brand in Model.Brands)
                    {
                        <a class="content-link">
                          <img src="@brand.ImageUrl" width="108" height="36" loading="lazy" alt="@brand.Name">
                        </a>
                    }
                }
                else
                {
                    <a class="content-link"><img src="~/assets/img/brand/b1.png" alt="Brand"></a>
                    <a class="content-link"><img src="~/assets/img/brand/b2.png" alt="Brand"></a>
                }
              </div>

              <div class="content-item">
                @if(Model.Brands != null && Model.Brands.Any())
                {
                    foreach(var brand in Model.Brands)
                    {
                        <a class="content-link">
                          <img src="@brand.ImageUrl" width="108" height="36" loading="lazy" alt="@brand.Name">
                        </a>
                    }
                }
                 else
                {
                    <a class="content-link"><img src="~/assets/img/brand/b1.png" alt="Brand"></a>
                    <a class="content-link"><img src="~/assets/img/brand/b2.png" alt="Brand"></a>
                }
              </div>

            </div>
          </div>
        </div>
      </div>

      <team-slider class="team-slider mt-100">
        <div class="container">
            <div class="section-headings headings-width text-center">
                <h2 class="heading text-50 aos-init aos-animate" data-aos="fade-up">
                    @(string.IsNullOrEmpty(Model.AboutInfo?.TeamSectionTitle) ? "Meet the experts behind your success" : Model.AboutInfo.TeamSectionTitle)
                </h2>
            </div>
        </div>
      </team-slider>
      
      <div class="faq mt-100">
          <div class="container">
          </div>
      </div>

</main>
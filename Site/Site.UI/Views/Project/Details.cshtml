@model Site.UI.Models.ProjectDetailViewModel

@{
    ViewData["Title"] = Model.Project?.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Onaylı yorumları filtrele
    var approvedComments = Model.Project?.Comments?.Where(c => c.IsApproved).ToList() ?? new List<ThreeLayerProject.Entities.Models.ProjectComment>();
}

<main>
    <div class="page-banner overlay">
        <div class="page-banner-content">
            <div class="container text-center">
                <h1 class="heading text-80 fw-700" data-aos="fade-up">@Model.Project?.Title</h1>
            </div>
        </div>
    </div>

    <div class="page-project-details mt-100">
        <div class="container">
            
            <div class="project-media radius18 mb-5" data-aos="fade-up">
                 @if(!string.IsNullOrEmpty(Model.Project?.ImageUrl))
                 {
                    <img src="@Model.Project.ImageUrl" alt="@Model.Project.Title" width="1400" height="637" loading="lazy" style="width: 100%; object-fit: cover;">
                 }
            </div>

            <div class="container">
                <div class="project-details-content">
                    <div class="row">
                        <div class="col-lg-7 col-12">
                            <div class="content-details-inner">
                                <h2 class="heading text-50 aos-init" data-aos="fade-up">Proje Hakkında</h2>
                                <div class="text text-18 aos-init mt-4" data-aos="fade-up">
                                    @Html.Raw(Model.Project?.Description)
                                </div>
                            </div>
                            
                            <div class="comments-section mt-5">
                                <h3 class="heading text-36">Yorumlar (@approvedComments.Count)</h3>
                                
                                @if(TempData["Success"] != null)
                                {
                                    <div class="alert alert-success mt-3">@TempData["Success"]</div>
                                }

                                <ul class="list-unstyled mt-4">
                                    @foreach(var comment in approvedComments)
                                    {
                                        <li class="mb-4 pb-4 border-bottom">
                                            <div class="d-flex justify-content-between">
                                                <h5 class="mb-1">@comment.FullName</h5>
                                                <small class="text-muted">@comment.CreatedDate.ToString("dd MMM yyyy")</small>
                                            </div>
                                            <p class="mb-0">@comment.CommentText</p>
                                        </li>
                                    }
                                    @if(approvedComments.Count == 0)
                                    {
                                        <p class="text-muted">Henüz yorum yapılmamış.</p>
                                    }
                                </ul>
                            </div>

                            <div class="comments-form mt-5 mb-5">
                                <h4 class="mb-4">Yorum Yap</h4>
                                <form asp-action="PostComment" method="post" class="form contact-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="NewComment.ProjectId" value="@Model.Project?.Id" />

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <input asp-for="NewComment.FullName" class="form-control" placeholder="Adınız Soyadınız *" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <input asp-for="NewComment.Email" type="email" class="form-control" placeholder="Email Adresiniz *" required>
                                        </div>
                                        <div class="col-12 mb-3">
                                            <textarea asp-for="NewComment.CommentText" class="form-control" rows="4" placeholder="Yorumunuz *" required></textarea>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="button button--primary">Gönder</button>
                                        </div>
                                    </div>
                                </form>
                            </div>

                        </div>

                        <div class="col-lg-5 col-12">
                            <div class="project-sidebar">
                                <div class="sidebar-widget project-info radius18" data-aos="fade-up">
                                   <h2 class="heading text-24">Proje Bilgileri</h2>
                                   <ul class="project-info-list list-unstyled">
                                        <li class="project-info-item">
                                            <div class="info-title heading text-18">Müşteri:</div>
                                            <div class="info-data text text-16">@Model.Project?.Client</div>
                                        </li>
                                        <li class="project-info-item">
                                            <div class="info-title heading text-18">Tarih:</div>
                                            <div class="info-data text text-16">@Model.Project?.ProjectDate</div>
                                        </li>
                                        <li class="project-info-item">
                                            <div class="info-title heading text-18">Kategori:</div>
                                            <div class="info-data text text-16">@Model.Project?.Category</div>
                                        </li>
                                        <li class="project-info-item">
                                            <div class="info-title heading text-18">Website:</div>
                                            <div class="info-data text text-16">
                                                <a href="@Model.Project?.WebsiteUrl" target="_blank">Siteye Git</a>
                                            </div>
                                        </li>
                                   </ul>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
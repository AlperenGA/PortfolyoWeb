@model IEnumerable<ThreeLayerProject.Entities.Models.Blog>

@{
    ViewData["Title"] = "Blog Yazıları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
    <div class="page-banner overlay">
        <picture class="media media-bg">
            <source media="(max-width: 575px)" srcset="~/assets/img/banner/page-banner-575.jpg">
            <source media="(max-width: 991px)" srcset="~/assets/img/banner/page-banner-991.jpg">
            <img src="~/assets/img/banner/page-banner.jpg" width="1920" height="520" loading="eager" alt="Page Banner">
        </picture>
        <div class="page-banner-content">
            <div class="container text-center">
                <h1 class="heading text-80 fw-700" data-aos="fade-up">Blog Yazıları</h1>
                <ul class="breadcrumb list-unstyled" data-aos="fade-up" data-aos-delay="100">
                    <li><a asp-controller="Home" asp-action="Index" class="text text-18">Anasayfa</a></li>
                    <li><svg width="8" height="12" viewBox="0 0 8 12" fill="none"><path d="..." fill="currentColor"/></svg></li>
                    <li><a class="text text-18 active">Blog</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="page-blog mt-100 mb-100">
        <div class="container">
            <div class="row product-grid">
                
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-12 col-md-6 col-lg-4" data-aos="fade-up">
                            <div class="card-blog radius18">
                                <div class="card-blog-top">
                                    <div class="card-blog-meta">
                                        <div class="card-blog-meta-item text text-18">
                                            <svg width="16" height="18" viewBox="0 0 16 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="..." fill="currentColor"/></svg>
                                            Admin
                                        </div>
                                        <div class="card-blog-meta-item text text-18">
                                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="..." fill="currentColor"/></svg>
                                            @item.CreatedDate.ToString("dd MMMM yyyy")
                                        </div>
                                    </div>
                                    <h2 class="card-blog-heading heading text-22">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="heading text-22">@item.Title</a>
                                    </h2>
                                </div>
                                <a class="card-blog-bottom" asp-action="Details" asp-route-id="@item.Id">
                                    <span class="blog-tag subheading subheading-bg text-16 fw-500">Blog</span>
                                    <div class="media">
                                        @if(!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Title" width="1000" height="707" loading="lazy" style="object-fit: cover;">
                                        }
                                        else
                                        {
                                            <img src="~/assets/img/blog/1.jpg" alt="Default Blog" width="1000" height="707" loading="lazy">
                                        }
                                    </div>
                                    <div class="buttons">
                                        <div class="button button--primary">
                                            Devamını Oku
                                            <svg viewBox="0 0 11 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="..." fill="currentColor"/></svg>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center">
                        <p class="text-18 text-muted">Henüz blog yazısı eklenmemiş.</p>
                    </div>
                }

            </div>
            
            </div>
    </div>
</main>
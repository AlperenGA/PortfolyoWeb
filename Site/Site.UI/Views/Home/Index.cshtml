@model Site.UI.Models.HomePageViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
      <div class="image-text mt-100">
        <div class="container">
          <div class="row align-items-center">
            
            <div class="col-lg-6 col-12">
              <div class="media-wrap aos-init" data-aos="zoom-in-up">
                 @if (!string.IsNullOrEmpty(Model.AboutInfo?.ImageUrl))
                 {
                    <img src="@Model.AboutInfo.ImageUrl" width="992" height="863" loading="lazy" alt="About Image" style="object-fit:cover;">
                 }
                 else
                 {
                    <img src="~/assets/img/image-text/img1.png" width="992" height="863" loading="lazy" alt="Image">
                 }
              </div>
            </div>

            <div class="col-lg-6 col-12">
              <div class="content section-headings">
                <div class="subheading text-20 subheading-bg aos-init" data-aos="fade-up">
                   <svg class="icon icon-14" ...>...</svg>
                   <span>Şirketimiz</span>
                   <svg class="icon icon-14" ...>...</svg>
                </div>

                <h2 class="heading text-50 aos-init" data-aos="fade-up">
                  @(Model.AboutInfo?.FullName ?? "Redesigning business for solutions")
                </h2>

                <div class="text text-18 aos-init" data-aos="fade-up">
                  @(Model.AboutInfo?.ShortDescription ?? "Our mission is to empowers businesses...")
                </div>

                <ul class="text-lists list-unstyled mt-3">
                   <li class="text-item text text-18 aos-init" data-aos="fade-up">
                      Yenilikçi Çözümler
                   </li>
                   <li class="text-item text text-18 aos-init" data-aos="fade-up">
                      Profesyonel Hizmet
                   </li>
                </ul>
                
                <div class="buttons aos-init mt-4" data-aos="fade-up">
                  <a asp-controller="About" asp-action="Index" class="button button--primary">
                    Daha Fazla Bilgi
                    <span class="svg-wrapper">
                        <svg class="icon-20" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="..." fill="currentColor"></path></svg>
                    </span>
                  </a>
                </div>

              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="running-content mt-100">
         <div class="container"><div class="content-inner"><div class="content-lists running-animation">...</div></div></div>
      </div>
      
      <div class="text-image-sticky mt-100">
        <div class="container">
          <div class="section-headings section-headings-horizontal align-items-start overflow-hidden">
            <div class="section-headings-left">
              <h2 class="heading text-50 aos-init" data-aos="fade-right">
                Son Yaptığımız Çalışmaları Keşfedin!
              </h2>
            </div>
            <div class="section-headings-right text text-18 aos-init" data-aos="fade-left">
              Yenilikçi ve sürdürülebilir çözümlerle işletmenizi geleceğe taşıyoruz.
            </div>
          </div>
          
          <div class="section-content">
             @if(Model.RecentProjects != null && Model.RecentProjects.Any())
             {
                @foreach(var project in Model.RecentProjects)
                {
                    <div class="image-text-card radius18 mb-4"> <div class="row align-items-center product-grid">
                        
                        <div class="col-lg-6 col-12">
                          <div class="content section-headings">
                            <div class="subheading text-20 subheading-bg aos-init" data-aos="fade-up">
                              <span>@project.Category</span>
                            </div>
                            <h2 class="heading text-50 aos-init" data-aos="fade-up">
                              @project.Title
                            </h2>
                            <div class="text text-18 aos-init" data-aos="fade-up">
                                @if(!string.IsNullOrEmpty(project.Description) && project.Description.Length > 150)
                                {
                                    @Html.Raw(project.Description.Substring(0, 150) + "...")
                                }
                                else
                                {
                                    @Html.Raw(project.Description)
                                }
                            </div>
                            <div class="buttons aos-init" data-aos="fade-up">
                              <a asp-controller="Project" asp-action="Details" asp-route-id="@project.Id" class="button button--primary">
                                Detayları Gör
                                <span class="svg-wrapper">
                                    <svg class="icon-20" ...>...</svg>
                                </span>
                              </a>
                            </div>
                          </div>
                        </div>

                        <div class="col-lg-6 col-12">
                          <div class="media-wrap radius18 aos-init" data-aos="zoom-in-up">
                             @if(!string.IsNullOrEmpty(project.ImageUrl))
                             {
                                <img src="@project.ImageUrl" width="1000" height="707" loading="lazy" alt="@project.Title" style="object-fit:cover;">
                             }
                             else
                             {
                                <img src="~/assets/img/project/1.jpg" width="1000" height="707" loading="lazy" alt="Project Image">
                             }
                          </div>
                        </div>

                      </div>
                    </div>
                }
             }
             else
             {
                 <p class="text-center">Henüz proje eklenmemiş.</p>
             }
          </div>
        </div>
      </div>
     

      <div class="featured-blog blog-style-3 mt-100 section-padding">
        <div class="container">
          <div class="section-headings text-center">
            <div class="subheading subheading-bg text-20 aos-init" data-aos="fade-up">
              <span>Blog</span>
            </div>
            <h2 class="heading text-50 aos-init" data-aos="fade-up" data-aos-delay="50">
              Bizden Son Haberler
            </h2>
          </div>
          
          <div class="section-content">
            <div class="row product-grid justify-content-center">
              
              @if(Model.RecentBlogs != null && Model.RecentBlogs.Any())
              {
                  @foreach(var blog in Model.RecentBlogs)
                  {
                      <div class="col-12 col-md-6 col-lg-4 aos-init" data-aos="fade-up">
                        <div class="card-blog-list aos-init" data-aos="fade-up">
                          
                          <div class="card-blog-list-media radius18">
                            <div class="media">
                               @if(!string.IsNullOrEmpty(blog.ImageUrl))
                               {
                                  <img src="@blog.ImageUrl" alt="@blog.Title" width="1000" height="707" loading="lazy" style="object-fit:cover;">
                               }
                               else
                               {
                                  <img src="~/assets/img/blog/1.jpg" alt="Blog Image" width="1000" height="707" loading="lazy">
                               }
                            </div>
                          </div>

                          <div class="card-blog-content">
                            <div class="card-blog-meta">
                              <div class="card-blog-meta-item text text-18">
                                <i class="bi bi-person me-1"></i> Admin
                              </div>
                              <div class="card-blog-meta-item text text-18">
                                <i class="bi bi-calendar me-1"></i> @blog.CreatedDate.ToString("dd MMM yyyy")
                              </div>
                            </div>

                            <h2 class="card-blog-heading heading text-22">
                              <a asp-controller="Blog" asp-action="Details" asp-route-id="@blog.Id" class="heading text-22">
                                @blog.Title
                              </a>
                            </h2>
                          </div>
                        </div>
                      </div>
                  }
              }
              else
              {
                  <div class="col-12 text-center">Henüz blog yazısı yok.</div>
              }

            </div>

            <div class="buttons buttons-discover aos-init" data-aos="fade-up" data-aos-delay="100">
              <a asp-controller="Blog" asp-action="Index" class="button button--primary" aria-label="Discover more blog posts">
                Tümünü Gör
                <span class="svg-wrapper">
                   </span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="why-choose-us bg-transparent mt-100 section-padding">...</div>
      <team-slider class="team-slider mt-100">...</team-slider>
      <div class="faq mt-100">...</div>

</main>
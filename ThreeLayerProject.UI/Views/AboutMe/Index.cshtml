@model ThreeLayerProject.UI.Models.AboutPageAdminViewModel

@{
    ViewData["Title"] = "Hakkımızda Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-5">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title mb-0">Hakkımızda İçeriği</h3>
    </div>
    <div class="card-body">
        <form asp-action="UpdateAbout" method="post" enctype="multipart/form-data">
            
            <div class="mb-3">
                <label class="form-label">Ana Başlık (Firma Adı)</label>
                <input type="text" name="FullName" value="@Model.AboutMe.FullName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Büyük Resim</label>
                <input type="file" name="file" class="form-control" />
                @if (!string.IsNullOrEmpty(Model.AboutMe.ImageUrl))
                {
                    <div class="mt-2">
                        <img src="@Model.AboutMe.ImageUrl" width="150" class="img-thumbnail" />
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Kısa Açıklama (Gri Alan)</label>
                <textarea name="ShortDescription" class="form-control" rows="3">@Model.AboutMe.ShortDescription</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Uzun Açıklama (HTML İçerik)</label>
                <textarea name="LongDescription" class="form-control" rows="6">@Model.AboutMe.LongDescription</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Takım Bölümü Başlığı</label>
                <input type="text" name="TeamSectionTitle" value="@Model.AboutMe.TeamSectionTitle" class="form-control" placeholder="Örn: Uzman Ekibimizle Tanışın" />
            </div>

            <button type="submit" class="btn btn-success">
                <i class="fas fa-save"></i> Değişiklikleri Kaydet
            </button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-warning text-dark">
        <h3 class="card-title mb-0">Marka Logoları (Kayan Şerit)</h3>
    </div>
    <div class="card-body">
        
        <form asp-action="AddBrand" method="post" enctype="multipart/form-data" class="row g-3 align-items-end mb-4 border-bottom pb-4">
            <div class="col-md-4">
                <label class="form-label">Marka Adı</label>
                <input type="text" name="name" class="form-control" placeholder="Örn: Microsoft" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Logo Seç</label>
                <input type="file" name="imageFile" class="form-control" required>
            </div>
            <div class="col-md-2">
                <label class="form-label">Sıra</label>
                <input type="number" name="order" class="form-control" value="1">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Ekle</button>
            </div>
        </form>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th style="width: 150px;">Logo</th>
                    <th>Marka Adı</th>
                    <th>Sıra</th>
                    <th style="width: 100px;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Brands != null && Model.Brands.Any())
                {
                    foreach (var brand in Model.Brands)
                    {
                        <tr>
                            <td class="text-center bg-light">
                                <img src="@brand.ImageUrl" style="max-height: 40px;" />
                            </td>
                            <td>@brand.Name</td>
                            <td>@brand.Order</td>
                            <td>
                                <form asp-action="DeleteBrand" method="post" onsubmit="return confirm('Bu logoyu silmek istediğine emin misin?');">
                                    <input type="hidden" name="id" value="@brand.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">Henüz hiç marka eklenmemiş.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
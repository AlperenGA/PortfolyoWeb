@model ThreeLayerProject.Entities.Models.Brand
@{ ViewData["Title"] = "Marka Düzenle"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Markayı Düzenle</h4>
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label>Marka Adı</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Mevcut Logo</label><br/>
                <img src="@Model.ImageUrl" width="150" class="mb-2 bg-light" />
                <input type="file" name="imageFile" class="form-control" />
                <small>Değiştirmek istemiyorsanız boş bırakın.</small>
            </div>

            <div class="mb-3">
                <label>Sıralama</label>
                <input asp-for="Order" class="form-control" type="number" />
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                <label class="form-check-label" asp-for="IsActive">Aktif mi?</label>
            </div>

            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>
@model IEnumerable<ThreeLayerProject.Entities.Models.Brand>
@{ ViewData["Title"] = "Markalar"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3>Marka Logoları</h3>
        <a asp-action="Create" class="btn btn-primary">Yeni Logo Ekle</a>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Marka Adı</th>
                    <th>Sıra</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model) {
                <tr>
                    <td>
                        <img src="@item.ImageUrl" style="width: 100px; height: auto; background:#ccc;" />
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Order</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Silmek istediğine emin misin?');">Sil</a>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
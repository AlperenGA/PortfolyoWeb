@model ThreeLayerProject.Entities.Models.Project

@{
    ViewData["Title"] = "Projeyi Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Projeyi Düzenle</h1>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@Model.Title</h5>

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">Başlık</label>
                            <div class="col-sm-10">
                                <input asp-for="Title" class="form-control" required />
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">Kategori</label>
                            <div class="col-sm-10">
                                <input asp-for="Category" class="form-control" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">Mevcut Resim</label>
                            <div class="col-sm-10">
                                @if(!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" width="150" class="mb-2 rounded" />
                                }
                                <input type="file" name="file" class="form-control" accept="image/*">
                                <small class="text-muted">Resmi değiştirmek istemiyorsanız boş bırakın.</small>
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-success">Güncelle</button>
                            <a asp-action="Index" class="btn btn-secondary">İptal</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>
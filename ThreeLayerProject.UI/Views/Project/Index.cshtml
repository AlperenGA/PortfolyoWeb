@model IEnumerable<ThreeLayerProject.Entities.Models.Project>

@{
    ViewData["Title"] = "Proje Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Projeler</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active">Projeler</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
                        <h5 class="card-title p-0 m-0">Tüm Projeler</h5>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-lg"></i> Yeni Proje Ekle
                        </a>
                    </div>

                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th scope="col">Resim</th>
                                <th scope="col">Başlık</th>
                                <th scope="col">Kategori</th>
                                <th scope="col">Müşteri</th>
                                <th scope="col">Tarih</th>
                                <th scope="col">Durum</th>
                                <th scope="col">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Title" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Resim Yok</span>
                                        }
                                    </td>
                                    <td class="fw-bold">@item.Title</td>
                                    <td>@item.Category</td>
                                    <td>@item.Client</td>
                                    <td>@item.ProjectDate</td>
                                    <td>
                                        @if (item.IsPublished)
                                        {
                                            <span class="badge bg-success">Yayında</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Taslak</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Düzenle">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('@item.Title başlıklı projeyi silmek istediğinize emin misiniz?');" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
            </div>

        </div>
    </div>
</section>
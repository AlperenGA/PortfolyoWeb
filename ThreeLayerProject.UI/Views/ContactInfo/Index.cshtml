@model ThreeLayerProject.Entities.Models.ContactInfo

@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>İletişim & Site Metinleri</h1>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Bilgileri Güncelle</h5>

                    @if(TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <form asp-action="Index" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label fw-bold">Ana Başlık (Banner)</label>
                            <div class="col-sm-9">
                                <input asp-for="MainHeading" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label fw-bold">Alt Açıklama</label>
                            <div class="col-sm-9">
                                <textarea asp-for="MainDescription" class="form-control" rows="3"></textarea>
                            </div>
                        </div>

                        <hr />

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Adres</label>
                            <div class="col-sm-9">
                                <input asp-for="Address" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Telefon</label>
                            <div class="col-sm-9">
                                <input asp-for="Phone" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Email</label>
                            <div class="col-sm-9">
                                <input asp-for="Email" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-9 offset-sm-3">
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>
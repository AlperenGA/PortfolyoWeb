@model ThreeLayerProject.Entities.Models.Blog

@{
    ViewData["Title"] = "Yeni Blog Yazısı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Yeni Yazı Ekle</h1>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Yazı Detayları</h5>

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">Başlık</label>
                            <div class="col-sm-10">
                                <input asp-for="Title" class="form-control" required placeholder="Örn: 2025 Web Tasarım Trendleri">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">Kapak Görseli</label>
                            <div class="col-sm-10">
                                <input type="file" name="file" class="form-control" accept="image/*">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">İçerik</label>
                            <div class="col-sm-10">
                                <textarea asp-for="Content" class="form-control" style="height: 300px"></textarea>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">Yayınlansın mı?</label>
                            <div class="col-sm-10">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsPublished" checked>
                                    <label class="form-check-label">Evet, sitede hemen göster.</label>
                                </div>
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            <a asp-action="Index" class="btn btn-secondary">İptal</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>
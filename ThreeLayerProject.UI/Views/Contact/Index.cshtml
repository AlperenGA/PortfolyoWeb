@model IEnumerable<ThreeLayerProject.Entities.Models.ContactMessage>

@{
    ViewData["Title"] = "Gelen Mesajlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Gelen Kutusu</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active">Mesajlar</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Ziyaretçi Mesajları</h5>

                    <table class="table datatable table-hover">
                        <thead>
                            <tr>
                                <th>Durum</th>
                                <th>Gönderen</th>
                                <th>Email</th>
                                <th>Konu</th>
                                <th>Tarih</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(!item.IsRead ? "fw-bold table-light" : "")">
                                    <td>
                                        @if (!item.IsRead)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-envelope-fill"></i> Yeni</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-envelope-open"></i> Okundu</span>
                                        }
                                    </td>
                                    <td>@item.Name</td>
                                    <td>@item.Email</td>
                                    <td>@item.Subject</td>
                                    <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (!item.IsRead)
                                        {
                                            <a asp-action="MarkAsRead" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="Okundu İşaretle">
                                                <i class="bi bi-check2-all"></i>
                                            </a>
                                        }
                                        
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bu mesajı silmek istediğinize emin misiniz?');" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="6" class="text-muted small ps-5 pb-3 pt-0 border-bottom-0">
                                        <i class="bi bi-chat-right-quote me-2"></i> @item.Message
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</section>
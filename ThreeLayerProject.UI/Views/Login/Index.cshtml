@model ThreeLayerProject.UI.Models.UserLoginViewModel

@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Giriş Yap";
}

<div class="container">
    <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">

                    <div class="d-flex justify-content-center py-4">
                        <a href="#" class="logo d-flex align-items-center w-auto" style="text-decoration: none;">
                            <img src="~/assetsAdmin/img/logo.png" alt="">
                            <span class="d-none d-lg-block">AdminPanel</span>
                        </a>
                    </div>
                    <div class="card mb-3">

                        <div class="card-body">

                            <div class="pt-4 pb-2">
                                <h5 class="card-title text-center pb-0 fs-4">Giriş Yap</h5>
                                <p class="text-center small">Yönetici paneline erişmek için bilgilerinizi giriniz</p>
                            </div>

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            <form class="row g-3 needs-validation" asp-action="Index" method="post" novalidate>

                                <div class="col-12">
                                    <label for="yourEmail" class="form-label">Email</label>
                                    <div class="input-group has-validation">
                                        <span class="input-group-text" id="inputGroupPrepend">@@</span>
                                        <input type="email" asp-for="Email" class="form-control" id="yourEmail" required>
                                        <div class="invalid-feedback">Lütfen email adresinizi girin.</div>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <label for="yourPassword" class="form-label">Şifre</label>
                                    <input type="password" asp-for="Password" class="form-control" id="yourPassword" required>
                                    <div class="invalid-feedback">Lütfen şifrenizi girin!</div>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                                        <label class="form-check-label" for="rememberMe">Beni Hatırla</label>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <button class="btn btn-primary w-100" type="submit">Giriş Yap</button>
                                </div>

                            </form>

                        </div>
                    </div>

                    <div class="credits">
                        Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a>
                    </div>

                </div>
            </div>
        </div>
    </section>
</div>
<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>@ViewData["Title"] - Admin Paneli</title>

  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <link href="~/assetsAdmin/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/assetsAdmin/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="~/assetsAdmin/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="~/assetsAdmin/vendor/quill/quill.snow.css" rel="stylesheet">
  <link href="~/assetsAdmin/vendor/quill/quill.bubble.css" rel="stylesheet">
  <link href="~/assetsAdmin/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="~/assetsAdmin/vendor/simple-datatables/style.css" rel="stylesheet">

  <link href="~/assetsAdmin/css/style.css" rel="stylesheet">
</head>

<body>

  <header id="header" class="header fixed-top d-flex align-items-center">

    <div class="d-flex align-items-center justify-content-between">
      <a asp-controller="Dashboard" asp-action="Index" class="logo d-flex align-items-center">
        <img src="~/assetsAdmin/img/logo.png" alt="">
        <span class="d-none d-lg-block">AdminPanel</span>
      </a>
      <i class="bi bi-list toggle-sidebar-btn"></i>
    </div>

    <nav class="header-nav ms-auto">
      <ul class="d-flex align-items-center">
        
        <li class="nav-item pe-3">
            <span id="sessionTimer" class="badge bg-warning text-dark" style="display:none;">Oturum kapanıyor: <span id="timeLeft">60</span>sn</span>
        </li>

        <li class="nav-item dropdown pe-3">
          <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
            <img src="~/assetsAdmin/img/profile-img.jpg" alt="Profile" class="rounded-circle">
            <span class="d-none d-md-block dropdown-toggle ps-2">@User.Identity?.Name</span>
          </a>

          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
            <li class="dropdown-header">
              <h6>@User.Identity?.Name</h6>
              <span>Yönetici</span>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
               <a class="dropdown-item d-flex align-items-center" asp-controller="Login" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Güvenli Çıkış</span>
              </a>
            </li>
          </ul>
        </li>
      </ul>
    </nav>
  </header>

  <aside id="sidebar" class="sidebar">
    <ul class="sidebar-nav" id="sidebar-nav">

      <li class="nav-item">
        <a class="nav-link " asp-controller="Dashboard" asp-action="Index">
          <i class="bi bi-grid"></i>
          <span>Genel Bakış</span>
        </a>
      </li>

      <li class="nav-heading">İçerik Yönetimi</li>

      <li class="nav-item">
        <a class="nav-link collapsed" asp-controller="Project" asp-action="Index">
          <i class="bi bi-briefcase"></i>
          <span>Projelerim</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link collapsed" asp-controller="Blog" asp-action="Index">
          <i class="bi bi-journal-text"></i>
          <span>Blog & Haberler</span>
        </a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link collapsed" asp-controller="Comment" asp-action="Index">
          <i class="bi bi-chat-dots"></i>
          <span>Yorum Yönetimi</span>
        </a>
      </li>

      <li class="nav-heading">Site Ayarları</li>

      <li class="nav-item">
        <a class="nav-link collapsed" asp-controller="AboutMe" asp-action="Index">
          <i class="bi bi-person-lines-fill"></i>
          <span>Hakkımda Yazısı</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link collapsed" asp-controller="ContactInfo" asp-action="Index">
          <i class="bi bi-info-circle"></i>
          <span>İletişim Bilgileri</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link collapsed" asp-controller="Contact" asp-action="Index">
          <i class="bi bi-envelope"></i>
          <span>Gelen Mesajlar</span>
        </a>
      </li>

      <li class="nav-item">
          <a class="nav-link text-dark" asp-controller="SiteSetting" asp-action="Index">
              <i class="fas fa-cogs"></i> Site Ayarları
          </a>
      </li>

      <li class="nav-item">
          <a class="nav-link text-dark" asp-controller="SocialMedia" asp-action="Index">
              <i class="fas fa-share-alt"></i> Sosyal Medya
          </a>
      </li>
      
      <li class="nav-heading">Hesap</li>

      <li class="nav-item">
        <a class="nav-link collapsed" asp-controller="Login" asp-action="Logout">
          <i class="bi bi-box-arrow-right"></i>
          <span>Güvenli Çıkış</span>
        </a>
      </li>

    </ul>
  </aside>

  <main id="main" class="main">
      @RenderBody()
  </main>

  <footer id="footer" class="footer">
    <div class="copyright">
      &copy; Copyright <strong><span>NiceAdmin</span></strong>.
    </div>
  </footer>

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <script src="~/assetsAdmin/vendor/apexcharts/apexcharts.min.js"></script>
  <script src="~/assetsAdmin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="~/assetsAdmin/vendor/chart.js/chart.umd.js"></script>
  <script src="~/assetsAdmin/vendor/echarts/echarts.min.js"></script>
  <script src="~/assetsAdmin/vendor/quill/quill.js"></script>
  <script src="~/assetsAdmin/vendor/simple-datatables/simple-datatables.js"></script>
  <script src="~/assetsAdmin/vendor/tinymce/tinymce.min.js"></script>
  <script src="~/assetsAdmin/vendor/php-email-form/validate.js"></script>

  <script src="~/assetsAdmin/js/main.js"></script>

  <script>
      let idleTime = 0;
      const warningTime = 540; // 9 dakika
      const logoutTime = 600;  // 10 dakika

      function timerIncrement() {
          idleTime++;
          if (idleTime >= warningTime) {
              document.getElementById("sessionTimer").style.display = "inline-block";
              document.getElementById("timeLeft").innerText = logoutTime - idleTime;
          }
          if (idleTime >= logoutTime) {
              window.location.href = '/Login/Logout';
          }
      }

      var idleInterval = setInterval(timerIncrement, 1000);

      function resetTimer() {
          idleTime = 0;
          document.getElementById("sessionTimer").style.display = "none";
      }

      document.onload = resetTimer;
      document.onmousemove = resetTimer;
      document.onkeypress = resetTimer;
      document.ontouchstart = resetTimer; 
      document.onclick = resetTimer; 
  </script>

  @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
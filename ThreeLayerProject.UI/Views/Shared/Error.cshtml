@model ThreeLayerProject.UI.Models.ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<section class="section">
    <div class="row">
        <div class="col-lg-6 offset-lg-3">
            <div class="card mt-5">
                <div class="card-body text-center pt-5">
                    <h1 class="text-danger">Bir Hata Oluştu.</h1>
                    <h2 class="text-danger">İsteğiniz işlenirken bir sorun meydana geldi.</h2>

                    @if (Model.ShowRequestId)
                    {
                        <p class="mt-4">
                            <strong>Request ID:</strong> <code>@Model.RequestId</code>
                        </p>
                    }

                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">Ana Sayfaya Dön</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>